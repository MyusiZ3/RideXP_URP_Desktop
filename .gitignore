# Unity standard .gitignore
# Ignore Unity temporary, cache, and build directories
/[Ll]library/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Visual Studio / IDE cache and project files
.vs/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.gradle/

ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports & OS junk
sysinfo.txt
CrashReport*
.DS_Store
Thumbs.db
desktop.ini

# Heavy asset store package archives & heavy 3D/Texture binary files
*.unitypackage
*.zip
*.rar
*.7z
*.tar
*.gz
*.tga
*.fbx
*.exr
*.hdr
*.raw
*.bytes

# Heavy 3rd-party Asset Store Vendor Plugins & Terrain Packs (Ignore to keep GitHub repo lightweight without Git LFS)
/Assets/7 Environment/
/Assets/Procedural Worlds/
/Assets/Gaia User Data/
/Assets/UniStorm Weather System/
/Assets/VolumetricLights/
/Assets/VolumetricLightsBundle/
/Assets/ANIMALS FULL PACK/
/Assets/_TerrainAutoUpgrade/
